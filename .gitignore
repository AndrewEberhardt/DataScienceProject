# --- Data ---
# Data files in data/ ARE committed: the graders load them from GitHub with URL links
# (see README "Where to put the data"). Files must stay under 100 MB (GitHub limit).
# Data files anywhere else in the repo are ignored:
*.csv
*.tsv
*.xlsx
*.xls
*.json.gz
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.nc
*.npy
*.npz
*.zip
*.gz
*.tar
*.7z
*.tif
*.tiff
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.geojson
!data/**

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Secrets ---
.env
